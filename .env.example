# Copy this file to .env and fill in real values locally.
# .env is gitignored - never commit real secrets.

DB_URL=jdbc:mysql://localhost:3306/scancrunch
DB_USERNAME=root
DB_PASSWORD=changeme

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Use a long, random value in real environments - do not reuse this one.
JWT_SECRET=change-this-to-a-long-random-secret-value
JWT_EXPIRATION=86400000

FRONTEND_URL=http://3.7.70.119
SERVER_PORT=8081

MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
